{
	"schemaVersion": 1,
	"id": "carrotmod",
	"version": "${version}",
	"name": "CarrotMod",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/carrotmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.carrot.carrotmod.CarrotMod"
		],
		"client": [
			"carrot.carrotmod.net.client.CarrotModClient"
		]
	},
	"mixins": [
		"carrotmod.mixins.json",
		{
			"config": "carrotmod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	}
}